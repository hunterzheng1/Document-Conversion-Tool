# ============================================================
# DocConv 环境变量配置模板
# 复制为 .env 并填入真实值：cp .env.example .env
# ============================================================

# --- AI 模型 API Key（必填其一）---
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# --- 可选：OpenAI 兼容 API 基础 URL ---
OPENAI_BASE_URL=

# --- 配置文件路径（可选，默认 config/config.yaml）---
DOCCONV_CONFIG=

# --- 数据根目录 ---
STORAGE_ROOT=.data/docconv

# --- 服务配置 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- 运行模式 ---
SERVER_ENABLED=true
WORKER_ENABLED=true

# --- 日志 ---
LOG_LEVEL=INFO

# --- Worker 配置 ---
WORKER_POLL_INTERVAL=2
MAX_RUNNING_JOBS=1

# --- 容器 ---
NON_ROOT=true
