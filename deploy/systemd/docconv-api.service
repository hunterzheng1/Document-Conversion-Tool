# DocConv API 服务单元文件
# 安装到 /etc/systemd/system/docconv-api.service
#
# 启用开机自启：systemctl enable docconv-api
# 启动服务：systemctl start docconv-api
# 查看日志：journalctl -u docconv-api -f

[Unit]
Description=DocConv API Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=docconv
Group=docconv
WorkingDirectory=/opt/docconv
ExecStart=/opt/docconv/venv/bin/docconv serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

# 环境变量文件
EnvironmentFile=/etc/docconv/.env

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data

# 日志到 journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=docconv-api

[Install]
WantedBy=multi-user.target
